# LazyAgents Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME=LazyAgents
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# =============================================================================
# DATABASE
# =============================================================================
# SQLite (default) - no configuration needed
# DATABASE_URL=sqlite:///./data/lazy-agents.db

# PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@localhost:5432/lazy_agents

# =============================================================================
# LLM PROVIDERS (at least one required)
# =============================================================================

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic (optional)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Google AI (optional)
# GOOGLE_API_KEY=your-google-api-key

# OpenRouter (optional - access to many models)
# OPENROUTER_API_KEY=sk-or-your-openrouter-key

# Local LLM via Ollama (optional)
# OLLAMA_BASE_URL=http://localhost:11434

# =============================================================================
# INTEGRATIONS
# =============================================================================

# GitHub
# GITHUB_TOKEN=ghp_your_github_token

# Discord
# DISCORD_BOT_TOKEN=your_discord_bot_token

# Slack
# SLACK_BOT_TOKEN=xoxb-your-slack-token
# SLACK_SIGNING_SECRET=your-signing-secret

# Notion
# NOTION_API_KEY=secret_your_notion_key

# =============================================================================
# SECURITY
# =============================================================================
# Required in non-development mode.
# Startup fails if this is missing, too short, or left at insecure defaults.
# Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-64-char-random-hex-secret

# Required in non-development mode.
# Startup fails if this is blank.
API_KEY=la-replace-with-random-api-key

# -----------------------------------------------------------------------------
# Development convenience overrides (optional)
# -----------------------------------------------------------------------------
# APP_ENV=development
# APP_DEBUG=true

# =============================================================================
# REDIS (optional - for production job queue)
# =============================================================================
# REDIS_URL=redis://localhost:6379/0

# =============================================================================
# ADVANCED
# =============================================================================
# LOG_LEVEL=INFO
# MAX_AGENT_EXECUTION_TIME=300
# MAX_TOKENS_PER_REQUEST=4096
